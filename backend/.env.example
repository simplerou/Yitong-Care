# 本地开发配置；密码填写到 backend/.env，切勿提交真实密码。
APP_ENV=development
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=yitong_care
MYSQL_USER=yitong
MYSQL_PASSWORD=
# 本机 MySQL 使用 Unix socket 时填写；留空则使用上面的 TCP 地址。
MYSQL_UNIX_SOCKET=
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=10
MYSQL_CONNECT_TIMEOUT=5
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# 原文件保存在 backend/var/uploads；可用绝对路径覆盖。
# UPLOAD_DIR=/absolute/path/to/uploads
MAX_UPLOAD_BYTES=52428800

# ============================================================
# 模型配置模板（填在本地 .env 中，后续接入代码时使用）
# Embedding 已接入向量入库与检索；聊天模型已接入政策顾问 LangGraph 问答。
# 字符串放在双引号内；没有的参数先保持空白，不要填写说明文字。
# ============================================================

# 一、聊天大模型：用于 Agent 最终生成回答
# 使用兼容 OpenAI 的 API；BASE_URL 填到 /v1，不要加 /chat/completions。
# 通义示例地址：https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=""
LLM_API_KEY=""
# 填服务商提供的模型标识，例如 qwen-plus；不要填中文展示名称。
LLM_MODEL=""
# 请求超时，单位为秒。
LLM_TIMEOUT_SECONDS=60

# 二、Embedding 模型：用于文本块和问题的向量化
# BASE_URL 填到 /v1，不要加 /embeddings。
# 可以与聊天模型使用相同服务地址或 API Key，但需要单独填写。
EMBEDDING_BASE_URL=""
EMBEDDING_API_KEY=""
# 填 Embedding 模型标识，例如 text-embedding-v3 或本地服务的实际模型名。
EMBEDDING_MODEL=""
# 填实际输出向量的维度，只填整数，例如 1024；不确定时先留空。
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=60

# 更换相同名称模型的实际权重时递增此版本，避免索引混用。
EMBEDDING_REVISION=1
# FAISS_INDEX_DIR=/absolute/path/to/faiss

# 政策顾问可检索的知识库 ID（JSON 数组，由后端控制，不由前端传入）
POLICY_KB_IDS=["general"]

# Tavily 联网搜索（政策顾问官方网页搜索与正文提取）
# 在本地 .env 的双引号中填 API Key；不要将真实 Key 提交到 Git。
TAVILY_API_KEY=""
TAVILY_TIMEOUT_SECONDS=20
TAVILY_MAX_RESULTS=3
# JSON 数组，默认仅检索中国政府网站；返回 URL 也会再次校验。
TAVILY_INCLUDE_DOMAINS=["gov.cn"]

# 批量网页正文提取通常比搜索慢，单独设置超时（秒）
TAVILY_EXTRACT_TIMEOUT_SECONDS=60
