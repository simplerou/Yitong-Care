# 本地开发配置；密码填写到 backend/.env，切勿提交真实密码。
APP_ENV=development
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=yitong_care
MYSQL_USER=yitong
MYSQL_PASSWORD=
# 本机 MySQL 使用 Unix socket 时填写；留空则使用上面的 TCP 地址。
MYSQL_UNIX_SOCKET=
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=10
MYSQL_CONNECT_TIMEOUT=5
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# 原文件保存在 backend/var/uploads；可用绝对路径覆盖。
# UPLOAD_DIR=/absolute/path/to/uploads
MAX_UPLOAD_BYTES=52428800

# ============================================================
# 模型配置模板（填在本地 .env 中，后续接入代码时使用）
# Embedding 已接入向量入库与检索；聊天模型已接入政策顾问 LangGraph 问答。
# 字符串放在双引号内；没有的参数先保持空白，不要填写说明文字。
# ============================================================

# 一、聊天大模型：用于 Agent 最终生成回答
# 使用兼容 OpenAI 的 API；BASE_URL 填到 /v1，不要加 /chat/completions。
# 通义示例地址：https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=""
LLM_API_KEY=""
# 填服务商提供的模型标识，例如 qwen-plus；不要填中文展示名称。
LLM_MODEL="qwen-plus-2025-12-01"
# 每周菜单生成专用模型；留空时沿用 LLM_MODEL，共用服务地址与 API Key
MENU_LLM_MODEL="qwen-plus-2025-07-14"
# 请求超时，单位为秒。
LLM_TIMEOUT_SECONDS=60

# 二、Embedding 模型：用于文本块和问题的向量化
# BASE_URL 填到 /v1，不要加 /embeddings。
# 可以与聊天模型使用相同服务地址或 API Key，但需要单独填写。
EMBEDDING_BASE_URL=""
EMBEDDING_API_KEY=""
# 填 Embedding 模型标识，例如 text-embedding-v3 或本地服务的实际模型名。
EMBEDDING_MODEL=""
# 填实际输出向量的维度，只填整数，例如 1024；不确定时先留空。
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=60

# 更换相同名称模型的实际权重时递增此版本，避免索引混用。
EMBEDDING_REVISION=1
# FAISS_INDEX_DIR=/absolute/path/to/faiss

# 政策顾问可检索的知识库 ID（JSON 数组，由后端控制，不由前端传入）
POLICY_KB_IDS=["general"]

# 健康管家可检索的知识库 ID 与启用开关；建议单独建立健康知识库后修改此处
HEALTH_KB_IDS=["general"]
HEALTH_ENABLED=true

# 用药管家可检索的知识库 ID 与启用开关；建议单独建立合理用药知识库后修改此处
MEDICATION_KB_IDS=["general"]
MEDICATION_ENABLED=true

# 膳食营养师可检索的知识库 ID 与启用开关；建议单独建立老年营养知识库后修改此处
DIET_KB_IDS=["general"]
DIET_ENABLED=true

# 安全守护可检索的知识库 ID 与启用开关；建议单独建立跌倒干预与适老化改造知识库后修改此处
SAFETY_KB_IDS=["general"]
SAFETY_ENABLED=true

# 心灵陪伴可检索的知识库 ID 与启用开关；建议单独建立老年心理关怀知识库后修改此处
MIND_KB_IDS=["general"]
MIND_ENABLED=true

# Tavily 联网搜索（政策顾问官方网页搜索与正文提取）
# 在本地 .env 的双引号中填 API Key；不要将真实 Key 提交到 Git。
TAVILY_API_KEY=""
TAVILY_TIMEOUT_SECONDS=20
TAVILY_MAX_RESULTS=3
# JSON 数组，默认仅检索中国政府网站；返回 URL 也会再次校验。
TAVILY_INCLUDE_DOMAINS=["gov.cn"]

# 批量网页正文提取通常比搜索慢，单独设置超时（秒）
TAVILY_EXTRACT_TIMEOUT_SECONDS=60

# 官方网页搜索+正文结果短期缓存；0关闭，最新/效力问题自动绕过
TAVILY_CACHE_TTL_SECONDS=300

# 首轮无可用正文时的市级补搜次数，0关闭，最多2
TAVILY_FALLBACK_SEARCHES=2

# HowToCook MCP：魔搭服务配置选择 Streamable HTTP，专属地址属于敏感信息
HOWTOCOOK_ENABLED=false
HOWTOCOOK_MCP_URL=""
# 仅当服务要求 Bearer Token 时填写
HOWTOCOOK_API_TOKEN=""
HOWTOCOOK_CATEGORIES=["早餐","主食","荤菜","素菜","汤与粥","水产"]
HOWTOCOOK_MAX_RECIPES=24
HOWTOCOOK_TIMEOUT_SECONDS=120

# 老人语音输入：DashScope 原生音频识别接口，与聊天模型配置独立
# 填完整接口地址（不是 /v1，也不是 /chat/completions）
ASR_API_URL="https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation"
ASR_MODEL="qwen-audio-3.0-asr-flash"
ASR_API_KEY=""
ASR_TIMEOUT_SECONDS=90
