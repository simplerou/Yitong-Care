# 本地开发配置；密码填写到 backend/.env，切勿提交真实密码。
APP_ENV=development
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=yitong_care
MYSQL_USER=yitong
MYSQL_PASSWORD=
# 本机 MySQL 使用 Unix socket 时填写；留空则使用上面的 TCP 地址。
MYSQL_UNIX_SOCKET=
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=10
MYSQL_CONNECT_TIMEOUT=5
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
